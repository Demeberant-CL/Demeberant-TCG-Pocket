<?xml version="1.0" encoding="utf-8"?>
<!-- API 26–30: default user-data backup, excluding regenerable diagnostics/meta.
     noBackupFilesDir and caches are excluded by Android. -->
<full-backup-content>
        <exclude domain="file" path="diagnostics/" />
        <exclude domain="file" path="pocket-meta.json" />
        <exclude domain="file" path="pocket-meta.json.bak" />
        <exclude domain="file" path="pocket-meta.json.new" />
</full-backup-content>
