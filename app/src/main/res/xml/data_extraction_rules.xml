<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: preserve databases/preferences/files except diagnostics/meta.
     IA connections remain in noBackupFilesDir; never copied by these rules. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="diagnostics/" />
        <exclude domain="file" path="pocket-meta.json" />
        <exclude domain="file" path="pocket-meta.json.bak" />
        <exclude domain="file" path="pocket-meta.json.new" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="diagnostics/" />
        <exclude domain="file" path="pocket-meta.json" />
        <exclude domain="file" path="pocket-meta.json.bak" />
        <exclude domain="file" path="pocket-meta.json.new" />
    </device-transfer>
</data-extraction-rules>
